{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": { "root": "web", "framework": "nextjs" },
    "backend": {
      "root": "backend", "framework": "fastapi", "entrypoint": "main:app",
      "buildCommand": "python compilar.py",
      "functions": { "main.py": { "maxDuration": 120, "includeFiles": "{modelo/**,datos/**,referencia.json}" } }
    }
  },
  "rewrites": [
    { "source": "/api/:path*", "destination": { "service": "backend" } },
    { "source": "/(.*)", "destination": { "service": "frontend" } }
  ]
}
